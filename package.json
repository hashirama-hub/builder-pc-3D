{
  "name": "pc-builder-3d",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["apps/web", "workers/api"],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "vitest run",
    "dev:api": "npm --prefix workers/api run dev",
    "deploy:api": "npm --prefix workers/api run deploy",
    "bundle:check:api": "npm --prefix workers/api run bundle:check",
    "seed": "npm --prefix workers/api run seed",
    "seed:remote": "npm --prefix workers/api run seed:remote",
    "seed:file": "node scripts/seed.mjs",
    "seed:ts": "node scripts/seed.ts",
    "test:watch": "vitest",
    "lint": "eslint . --ext ts,tsx"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "vitest": "^2.1.0",
    "typescript": "^5.6.0"
  }
}
